page {
  background: #f5f6f8;
  color: #2d3748;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container { padding: 24rpx; }

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 45, 61, 0.06);
}

.page-title { font-size: 40rpx; font-weight: 700; margin: 8rpx 0 24rpx; }

.topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.topbar .page-title { margin: 0; }

.add-btn {
  background: #2b6cb0;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 8rpx 28rpx;
  line-height: 1.6;
}
.add-btn::after { border: none; }

.btn-primary { background: #2b6cb0; color: #fff; border-radius: 12rpx; margin-top: 16rpx; }
.btn-primary::after { border: none; }
.btn-plain { background: #edf2f7; color: #2b6cb0; border-radius: 12rpx; margin-top: 12rpx; }
.btn-plain::after { border: none; }
.btn-danger { background: #fff; color: #e53e3e; border-radius: 12rpx; margin-top: 12rpx; border: 1rpx solid #feb2b2; }
.btn-danger::after { border: none; }

.empty { text-align: center; color: #a0aec0; padding: 120rpx 40rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.chip { background: #ebf4ff; color: #2b6cb0; border-radius: 999rpx; padding: 6rpx 20rpx; font-size: 24rpx; }

.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.empty-tip { color: #a0aec0; font-size: 26rpx; padding: 20rpx 0; }

.form-card { background: #fff; border-radius: 16rpx; padding: 8rpx 24rpx; margin-bottom: 24rpx; }
.field { padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.field:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #718096; margin-bottom: 12rpx; }
.input { width: 100%; font-size: 30rpx; }
.textarea { width: 100%; min-height: 120rpx; font-size: 28rpx; }
.picker-row { display: flex; gap: 20rpx; }
.picker { background: #f5f6f8; border-radius: 8rpx; padding: 12rpx 20rpx; font-size: 28rpx; }

.menu-item { display: flex; justify-content: space-between; align-items: center; }
