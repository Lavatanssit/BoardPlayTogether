.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rank-item:last-child { border-bottom: none; }
.rank-item.first .rank-num { background: #2b6cb0; color: #fff; }

.rank-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #edf2f7;
  color: #4a5568;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-name { flex: 1; font-size: 30rpx; }

.rank-tag {
  background: #ebf4ff;
  color: #2b6cb0;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
