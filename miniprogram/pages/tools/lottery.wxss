.tabs {
  display: flex;
  background: #edf2f7;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #718096;
}
.tab.active {
  background: #fff;
  color: #2b6cb0;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 45, 61, 0.08);
}

.result-card { text-align: center; }
.result-label { font-size: 26rpx; color: #a0aec0; margin-bottom: 16rpx; }
.result {
  font-size: 44rpx;
  font-weight: 700;
  color: #2b6cb0;
  min-height: 88rpx;
  line-height: 88rpx;
  word-break: break-all;
}
.result.placeholder { color: #cbd5e0; font-size: 28rpx; font-weight: 400; }
