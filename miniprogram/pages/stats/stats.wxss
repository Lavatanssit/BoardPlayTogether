.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.stat-item {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}

.stat-box {
  background: #f7fafc;
  border-radius: 12rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #2b6cb0;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #718096;
  margin-top: 6rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.rank-item:last-child { border-bottom: none; }

.rank-index {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #edf2f7;
  color: #718096;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-index.top { background: #2b6cb0; color: #fff; }

.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-count {
  color: #2b6cb0;
  font-size: 26rpx;
  margin-left: 16rpx;
  white-space: nowrap;
}
