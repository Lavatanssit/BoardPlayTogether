.profile-card { display: flex; align-items: center; }

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-btn::after { border: none; }

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #edf2f7;
  display: block;
}
.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.profile-info {
  flex: 1;
  margin-left: 28rpx;
}

.nickname-input {
  font-size: 34rpx;
  font-weight: 600;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.profile-tip {
  color: #a0aec0;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.menu .menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 4rpx;
  border-bottom: 1rpx solid #f0f2f5;
  font-size: 30rpx;
}
.menu .menu-item:last-child { border-bottom: none; }
.menu-hover { background: #f7fafc; }

.arrow { color: #cbd5e0; font-size: 40rpx; line-height: 1; }
