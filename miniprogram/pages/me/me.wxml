<view class="container">
  <view class="card profile-card" wx:if="{{!loading}}">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar placeholder">👤</view>
    </button>
    <view class="profile-info">
      <input
        class="nickname-input"
        type="nickname"
        placeholder="点击设置昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
      />
      <view class="profile-tip">点头像换头像，昵称输入后自动保存</view>
    </view>
  </view>

  <view class="card menu" wx:if="{{!loading}}">
    <view class="menu-item" hover-class="menu-hover" bindtap="goStats">
      <text>📊 我的统计</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" hover-class="menu-hover" bindtap="showHelp">
      <text>❓ 使用说明</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty"><text>加载中…</text></view>
</view>
