{
  "name": "boardplaytogether",
  "version": "1.0.0",
  "private": true,
  "description": "桌游聚会微信小程序（原生 + 微信云开发）",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lavatanssit/BoardPlayTogether.git"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "lint": "eslint \"miniprogram/**/*.js\" \"cloudfunctions/**/*.js\" \"scripts/**/*.js\"",
    "lint:fix": "eslint \"miniprogram/**/*.js\" \"cloudfunctions/**/*.js\" \"scripts/**/*.js\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "check": "npm run lint && npm run test",
    "preview": "node scripts/preview.js",
    "upload": "node scripts/upload.js",
    "new:session": "node scripts/new-session.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "miniprogram-ci": "^1.9.5"
  }
}
